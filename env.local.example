# ============================================
# 이 파일을 .env.local로 복사하여 실제 값을 입력하세요.
# cp env.local.example .env.local
# ============================================

# --------------------------------------------
# Clerk 인증 환경 변수
# Clerk Dashboard → API Keys에서 확인: https://dashboard.clerk.com/last-active?path=api-keys
# --------------------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=YOUR_PUBLISHABLE_KEY
CLERK_SECRET_KEY=YOUR_SECRET_KEY

# Clerk 리다이렉트 URL (선택사항)
# NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
# NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# --------------------------------------------
# Supabase 환경 변수
# Supabase 프로젝트 대시보드 → Settings → API에서 확인
# --------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Supabase Service Role Key - 서버 사이드에서만 사용 (관리자 기능용)
# 주의: 절대로 클라이언트에 노출하지 마세요!
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# --------------------------------------------
# Clerk + Supabase 통합 설정
# 
# 중요: Clerk Dashboard에서 JWT 템플릿을 생성해야 합니다!
# 1. Clerk Dashboard → JWT Templates로 이동
# 2. "New template" 클릭 → "Supabase" 선택
# 3. 템플릿 이름을 "supabase"로 설정
# 4. Supabase JWT Secret을 입력 (Supabase Dashboard → Settings → API → JWT Secret)
# --------------------------------------------

# --------------------------------------------
# 관리자 설정
# 관리자 권한을 가질 Clerk User ID (쉼표로 구분하여 여러 명 설정 가능)
# Clerk Dashboard → Users에서 User ID 확인
# --------------------------------------------
NEXT_PUBLIC_ADMIN_USER_IDS=user_xxx,user_yyy

# --------------------------------------------
# SEO 및 사이트 설정
# 프로덕션 배포 시 실제 도메인으로 변경하세요
# --------------------------------------------
NEXT_PUBLIC_SITE_URL=https://moviemaster.kr

